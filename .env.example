COMPOSE_PROJECT_NAME=madmallard
TZ=America/New_York
POSTGRES_PASSWORD=replace-with-long-random-secret
MARIADB_ROOT_PASSWORD=replace-with-long-random-secret
MARIADB_MATOMO_PASSWORD=replace-with-long-random-secret
REDIS_PASSWORD=replace-with-long-random-secret
POSTGRES_IMAGE=pgvector/pgvector:pg17
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:7.4
MATOMO_IMAGE=matomo:5-apache
MATOMO_BIND_IP=127.0.0.1
MATOMO_PORT=8088
METABASE_IMAGE=metabase/metabase:latest
METABASE_BIND_IP=127.0.0.1
METABASE_PORT=3003
METABASE_DB_PASSWORD=replace-with-unique-long-random-secret
METABASE_ENCRYPTION_SECRET_KEY=replace-with-random-key-at-least-16-characters
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_DB_PASSWORD=replace-with-unique-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-unique-long-random-secret
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
CHATWOOT_BIND_IP=127.0.0.1
CHATWOOT_PORT=3004
CHATWOOT_FRONTEND_URL=http://localhost:3004
CHATWOOT_DB_PASSWORD=replace-with-unique-long-random-secret
CHATWOOT_SECRET_KEY_BASE=replace-with-random-64-byte-hex-secret
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false
HORILLA_IMAGE=horilla/horilla-hr:2.2.0
HORILLA_BIND_IP=127.0.0.1
HORILLA_PORT=8000
HORILLA_ALLOWED_HOSTS=localhost,127.0.0.1
HORILLA_CSRF_TRUSTED_ORIGINS=http://localhost:8000
HORILLA_DB_PASSWORD=replace-with-unique-long-random-secret
HORILLA_SECRET_KEY=replace-with-random-secret-at-least-50-characters
HORILLA_DB_INIT_PASSWORD=replace-with-unique-setup-password
