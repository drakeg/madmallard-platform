COMPOSE_PROJECT_NAME=madmallard
TZ=America/New_York
POSTGRES_PASSWORD=replace-with-long-random-secret
MARIADB_ROOT_PASSWORD=replace-with-long-random-secret
MARIADB_MATOMO_PASSWORD=replace-with-long-random-secret
REDIS_PASSWORD=replace-with-long-random-secret
POSTGRES_IMAGE=postgres:17
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:7.4
MATOMO_IMAGE=matomo:5-apache
MATOMO_BIND_IP=127.0.0.1
MATOMO_PORT=8088
METABASE_IMAGE=metabase/metabase:latest
METABASE_BIND_IP=127.0.0.1
METABASE_PORT=3001
METABASE_DB_PASSWORD=replace-with-unique-long-random-secret
METABASE_ENCRYPTION_SECRET_KEY=replace-with-random-key-at-least-16-characters
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_BIND_IP=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_DB_PASSWORD=replace-with-unique-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-unique-long-random-secret
